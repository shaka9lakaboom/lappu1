{
  "name": "skillmirror",
  "version": "0.1.0",
  "private": true,
  "description": "SkillMirror monorepo: web app, Chrome extension, shared packages. The FastAPI backend lives in services/backend (Python).",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "apps/extension",
    "packages/contracts",
    "packages/config",
    "packages/ui"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @skillmirror/web",
    "dev:backend": "cd services/backend && python -m uvicorn app.main:app --reload --port 8000",
    "demo": "node scripts/demo.mjs",
    "demo:backend": "node scripts/demo.mjs backend",
    "demo:web": "node scripts/demo.mjs web",
    "demo:check": "node scripts/demo.mjs check",
    "demo:verify": "node scripts/demo.mjs verify",
    "test:demo": "node --test scripts/demo.test.mjs",
    "build:web": "npm run build --workspace @skillmirror/web",
    "build:extension": "npm run build --workspace @skillmirror/extension",
    "build": "npm run build:web && npm run build:extension",
    "lint": "npm run lint --workspace @skillmirror/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:backend": "cd services/backend && python -m pytest",
    "test:web": "npm run test --workspace @skillmirror/web",
    "test:extension": "npm run test --workspace @skillmirror/extension",
    "test:extension:unit": "npm run test:unit --workspace @skillmirror/extension",
    "e2e:auth": "npm run e2e:auth --workspace @skillmirror/web"
  }
}
