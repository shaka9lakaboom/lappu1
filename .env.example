# SkillMirror environment variable index - NAMES ONLY, never real values.
#
# Each app reads its own file; copy the matching template:
#   apps/web/.env.example         -> apps/web/.env.local
#   services/backend/.env.example -> services/backend/.env
#   (auth E2E only)               -> apps/web/.env.e2e.local  (SUPABASE_SERVICE_ROLE_KEY)
# All real env files are gitignored.

# --- Web (apps/web) - public, embedded in the browser bundle -------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

# --- Backend (services/backend) - server only ---------------------------
APP_ENV=
APP_NAME=
API_VERSION=
CORS_ORIGINS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
# Google AI (server only - never in web or extension code)
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_THINKING_LEVEL=
MODEL_TIMEOUT_SECONDS=
GEMINI_GENERATION_RPM=
GEMINI_EMBEDDING_RPM=
# Free-tier ModelGateway policy (ADR 0004)
GEMINI_ROUTINE_MODEL=
GEMINI_ROUTINE_THINKING_LEVEL=
MODEL_DAILY_REQUEST_LIMITS=
MODEL_QUOTA_RESERVE=
MODEL_QUOTA_TIMEZONE=
MODEL_RESULT_CACHE=
MODEL_RESULT_CACHE_MAX_ENTRIES=
TURN_ANALYSIS_MODE=
# In-process worker loop
WORKER_ENABLED=
WORKER_POLL_SECONDS=
WORKER_BATCH_SIZE=
WORKER_STALE_AFTER_SECONDS=

# --- Extension build (apps/extension, optional) - public values only -----
# Falls back to apps/web/.env.local NEXT_PUBLIC_* values when unset.
# SKILLMIRROR_SUPABASE_URL=
# SKILLMIRROR_SUPABASE_ANON_KEY=
# SKILLMIRROR_API_URL=
# SKILLMIRROR_WEB_URL=

# --- Auth E2E test runner only (never in web or extension code) ---------
# SUPABASE_SERVICE_ROLE_KEY=
# E2E_EMAIL_DOMAIN=
# E2E_BASE_URL=
