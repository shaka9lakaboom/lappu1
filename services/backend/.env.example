# SkillMirror backend - copy to services/backend/.env (never commit .env).
# Variable names only. Real values come from your Supabase project settings.

# development | test | staging | production  (staging/production require SUPABASE_URL and CORS_ORIGINS)
APP_ENV=
# Service name reported by GET /health (default: skillmirror-backend)
APP_NAME=
# Release version reported by GET /health (default: package version)
API_VERSION=
# Comma-separated exact origins (no wildcards). Local development:
#   http://localhost:3000,chrome-extension://cohpimnabjigooghbigblennedbplojm
# The extension id is fixed by apps/extension/manifest.json "key" (unpacked dev build).
CORS_ORIGINS=

# Project URL, e.g. https://<project-ref>.supabase.co - required to verify access tokens
SUPABASE_URL=
# Not read by the P1 code paths (ingestion uses DATABASE_URL)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy HS256 JWT secret; leave empty with asymmetric signing keys
SUPABASE_JWT_SECRET=

# PostgreSQL connection string for ingestion, e.g. the Supabase session pooler URI
# (Project Settings > Database > Connection string). Server-side only.
DATABASE_URL=
