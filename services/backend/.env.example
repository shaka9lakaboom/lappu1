# SkillMirror backend - copy to services/backend/.env (never commit .env).
# Variable names only. Real values come from your Supabase project settings.

# development | test | staging | production  (staging/production require SUPABASE_URL and CORS_ORIGINS)
APP_ENV=
# Service name reported by GET /health (default: skillmirror-backend)
APP_NAME=
# Release version reported by GET /health (default: package version)
API_VERSION=
# Comma-separated exact origins (no wildcards). Local development:
#   http://localhost:3000,chrome-extension://cohpimnabjigooghbigblennedbplojm
# The extension id is fixed by apps/extension/manifest.json "key" (unpacked dev build).
CORS_ORIGINS=

# Project URL, e.g. https://<project-ref>.supabase.co - required to verify access tokens
SUPABASE_URL=
# Not read by the backend (it uses DATABASE_URL)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy HS256 JWT secret; leave empty with asymmetric signing keys
SUPABASE_JWT_SECRET=

# PostgreSQL connection string for ingestion, e.g. the Supabase session pooler URI
# (Project Settings > Database > Connection string). Server-side only.
DATABASE_URL=

# Google AI API key (https://aistudio.google.com/apikey). Server-side only: never put it
# in apps/web or apps/extension, never commit it. Without it the model gateway is off,
# the worker does not start, and course bootstrap / processing jobs stay PENDING.
GEMINI_API_KEY=
# Model identifiers (architecture §14.1). Defaults: gemini-3.7-flash / gemini-embedding-2
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
# low | medium | high (default low; gemini-3.7-flash rejects "minimal")
GEMINI_THINKING_LEVEL=
# Per-call timeout in seconds (default 60)
MODEL_TIMEOUT_SECONDS=

# Durable worker loop (architecture §7.3). Runs inside the API process when DATABASE_URL
# and GEMINI_API_KEY are set (default true). Set false to run `python -m app.jobs.worker`.
WORKER_ENABLED=
# Idle poll interval in seconds (default 2), jobs per claim (default 4),
# and how old a PROCESSING lock must be before crash recovery retries it (default 900)
WORKER_POLL_SECONDS=
WORKER_BATCH_SIZE=
WORKER_STALE_AFTER_SECONDS=
