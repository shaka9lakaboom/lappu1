{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skillmirror/benchmark/case.schema.json",
  "title": "SkillMirror benchmark case (input only; expectations live in labels/)",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "family", "course", "turn"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "family": {
      "enum": ["relevance", "segmentation", "mapping", "attribution", "evidence", "debt", "abstention", "adversarial", "verification"]
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "subject": { "type": ["string", "null"] },
        "level": { "type": ["string", "null"] }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "assistant", "context_incomplete"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "assistant": { "type": ["string", "null"] },
        "recent_context": { "type": "string" },
        "context_incomplete": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" }
  }
}
