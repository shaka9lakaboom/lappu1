# SkillMirror web - copy to apps/web/.env.local (never commit it).
# NEXT_PUBLIC_* values are embedded in browser bundles at build time: only
# public values belong here. NEVER put a service-role or secret key here.

# Supabase > Project Settings > API: Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase > Project Settings > API Keys: the anon (legacy) or publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SkillMirror backend base URL, e.g. http://localhost:8000 (optional at P0; used for the API status panel)
NEXT_PUBLIC_API_URL=
