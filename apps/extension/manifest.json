{
  "manifest_version": 3,
  "name": "SkillMirror Companion",
  "version": "0.2.0",
  "description": "Use AI. Keep the skill. Companion extension for SkillMirror.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "SkillMirror",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": []
}
