{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillmirror.dev/schemas/event-batch-request.schema.json",
  "title": "EventBatchRequest",
  "description": "Body of POST /v1/events/batch: a bounded batch of RawActivityEnvelope (architecture §6.5). Mirrors services/backend/app/ingestion/models.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["client", "events"],
  "properties": {
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension_version", "adapter_version"],
      "properties": {
        "extension_version": { "type": "string", "pattern": "^[0-9A-Za-z._-]{1,32}$" },
        "adapter_version": { "type": "string", "pattern": "^[0-9A-Za-z._-]{1,32}$" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/RawActivityEnvelope" }
    }
  },
  "$defs": {
    "externalId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$" },
    "AttachmentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "filename", "mime_type", "content_available"],
      "properties": {
        "kind": { "enum": ["file", "image", "unknown"] },
        "filename": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
        "mime_type": { "type": ["string", "null"], "pattern": "^[a-z0-9.+-]{1,63}/[a-z0-9.+-]{1,63}$" },
        "content_available": { "type": "boolean" }
      }
    },
    "RawActivityEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id", "schema_version", "learner_id", "source_provider", "source_method",
        "external_conversation_id", "external_message_id", "external_parent_message_id",
        "message_index", "role", "content_text", "content_format", "occurred_at", "captured_at",
        "provider_model", "revision_index", "attachment_metadata", "context_incomplete",
        "active_course_id", "content_hash", "client_event_id"
      ],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "schema_version": { "const": 1 },
        "learner_id": { "type": "string", "format": "uuid" },
        "source_provider": { "enum": ["chatgpt", "claude", "gemini", "skillmirror"] },
        "source_method": { "enum": ["browser_extension", "native", "manual"] },
        "external_conversation_id": { "anyOf": [{ "$ref": "#/$defs/externalId" }, { "type": "null" }] },
        "external_message_id": { "anyOf": [{ "$ref": "#/$defs/externalId" }, { "type": "null" }] },
        "external_parent_message_id": { "anyOf": [{ "$ref": "#/$defs/externalId" }, { "type": "null" }] },
        "message_index": { "type": ["integer", "null"], "minimum": 0, "maximum": 100000 },
        "role": { "enum": ["user", "assistant"] },
        "content_text": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "content_format": { "enum": ["text", "markdown"] },
        "occurred_at": { "type": ["string", "null"], "format": "date-time" },
        "captured_at": { "type": "string", "format": "date-time" },
        "provider_model": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:/-]{1,100}$" },
        "revision_index": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "attachment_metadata": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/AttachmentMetadata" }
        },
        "context_incomplete": { "type": "boolean" },
        "active_course_id": { "type": ["string", "null"], "format": "uuid" },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "client_event_id": { "type": "string", "pattern": "^[A-Za-z0-9._:|-]{1,300}$" }
      }
    }
  }
}
